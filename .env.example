# DriveStats ADI App Developer Client IDs
# Set these keys so that users can log in with a single click without having to input Client IDs

# 1. Google OAuth Client ID (Web Application type)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Microsoft Outlook OAuth Application (Client) ID (Single-page Application type)
VITE_OUTLOOK_CLIENT_ID=your-microsoft-client-id

# 3. Master Google Gemini AI Key (allows users to get instant AI coaching without entering their own key)
VITE_GEMINI_API_KEY=your-gemini-api-key
